{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@nova/types": ["../../packages/types"],
      "@nova/fairness": ["../../packages/fairness"],
      "@nova/game-engine": ["../../packages/game-engine"]
    }
  },
  "include": ["src/**/*"]
}
