# ==============================================================================
# NOVA Gaming Platform - Admin Portal Frontend Dockerfile
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@10.0.0

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/ ./packages/
COPY apps/admin/package.json ./apps/admin/

RUN pnpm install --frozen-lockfile

COPY apps/admin/ ./apps/admin/

RUN pnpm --filter @nova/admin run build

# Stage 2: Minimal exporter for Caddy volume mount
FROM alpine:3.20 AS exporter

WORKDIR /dist

COPY --from=builder /app/apps/admin/dist ./

CMD ["cp", "-r", "/dist/.", "/var/www/admin/"]
