# ==============================================================================
# NOVA Gaming Platform - Player Web Frontend Dockerfile
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@10.0.0

# Build Arguments for client-side API and Socket endpoints
ARG VITE_API_URL
ARG VITE_SOCKET_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages/ ./packages/
COPY games/ ./games/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

COPY apps/web/ ./apps/web/

RUN pnpm --filter @nova/web run build

# Stage 2: Serve via high-performance Nginx / Volume Exporter
FROM alpine:3.20 AS exporter

WORKDIR /dist

COPY --from=builder /app/apps/web/dist ./

# Container simply preserves static dist files for Caddy volume mount
CMD ["cp", "-r", "/dist/.", "/var/www/web/"]
