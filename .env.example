# ==============================================================================
# NOVA Gaming Platform - Root Production Environment Template
# ==============================================================================
# Copy this file to .env on your production host and populate with strong secrets.
# Do NOT commit .env to version control!

# Application Environment (production | development | test)
NODE_ENV=production

# Server Ports and Host
PORT=5000
HOST=0.0.0.0

# Domain and Origin Configuration
DOMAIN=novagame.et
WEB_ORIGIN=https://novagame.et
ADMIN_ORIGIN=https://admin.novagame.et

# Client-Side Public Endpoints (Passed into Web/Admin Vite builds)
VITE_API_URL=https://novagame.et/api/v1
VITE_SOCKET_URL=https://novagame.et

# Database (PostgreSQL Connection String)
# Internal docker-compose network connection: postgresql://nova:<POSTGRES_PASSWORD>@postgres:5432/nova_gaming?schema=public
DATABASE_URL=postgresql://nova:CHANGE_THIS_TO_STRONG_PASSWORD_123@postgres:5432/nova_gaming?schema=public
POSTGRES_USER=nova
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_123
POSTGRES_DB=nova_gaming

# Redis (Session synchronization, Socket.IO adapter & Leader election)
# Internal docker-compose network connection: redis://redis:6379
REDIS_URL=redis://redis:6379

# Cryptographic & JWT Secrets (Must be at least 32 characters long)
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_KEY_OF_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Initial Production Superadmin Seed Account
INITIAL_ADMIN_EMAIL=admin@novagame.et
INITIAL_ADMIN_USERNAME=NovaAdmin
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_SECURE_ADMIN_PASSWORD_XYZ!

# Location-Based Access Control (Optional: comma-separated ISO country codes, e.g. "ET" for Ethiopia, or leave empty for no restriction)
GEO_ALLOWED_COUNTRIES=ET

# Monitoring & Error Tracking (Optional)
SENTRY_DSN=
