{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nova/*": [
        "../../*/src/index.ts"
      ],
      "@nova/ui": [
        "../../ui/src/index.tsx"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
