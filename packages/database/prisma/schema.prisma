generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_REFUND
  BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String             @id @default(uuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  avatarUrl    String?
  role         Role               @default(USER)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  wallet       Wallet?
  seeds        ProvablyFairSeed[]
  bets         Bet[]
}

model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float         @default(1000.0) // Free starting demo balance
  currency      String        @default("USD")
  lockedBalance Float         @default(0.0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  referenceId String?
  description String?
  createdAt   DateTime          @default(now())
}

model ProvablyFairSeed {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bets Bet[]

  @@index([userId, active])
}

model Bet {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedId         String?
  seed           ProvablyFairSeed? @relation(fields: [seedId], references: [id])
  gameId         String           // coin-flip, dice, crash, roulette
  amount         Float
  multiplier     Float
  payout         Float
  profit         Float
  won            Boolean
  outcome        Json
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([gameId])
}

model GameConfig {
  id               String   @id @default(uuid())
  gameId           String   @unique
  name             String
  houseEdgePercent Float    @default(1.0)
  minBet           Float    @default(1.0)
  maxBet           Float    @default(10000.0)
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}
