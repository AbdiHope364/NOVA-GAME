# ==============================================================================
# NOVA Gaming Platform - Backend API Service Environment (.env.example)
# ==============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://nova:CHANGE_THIS_TO_STRONG_PASSWORD_123@localhost:5432/nova_gaming?schema=public

# Redis URL (For distributed Socket.IO adapter and leader election)
REDIS_URL=redis://localhost:6379

# JWT Cryptographic Secret (min 32 characters)
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_KEY_OF_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Allowed Origins for CORS (No wildcard permitted in production)
WEB_ORIGIN=https://novagame.et
ADMIN_ORIGIN=https://admin.novagame.et

# Platform Default Settings
HOUSE_EDGE_PERCENT=1.0

# Initial Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@novagame.et
INITIAL_ADMIN_USERNAME=NovaAdmin
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_SECURE_ADMIN_PASSWORD_XYZ!

# Location-Based Access Restriction (Optional: comma-separated ISO codes e.g. "ET")
GEO_ALLOWED_COUNTRIES=ET

# Error Monitoring (Optional Sentry DSN)
SENTRY_DSN=

