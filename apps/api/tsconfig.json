{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nova/types": ["../../packages/types/src/index.ts"],
      "@nova/database": ["../../packages/database/src/index.ts"],
      "@nova/fairness": ["../../packages/fairness/src/index.ts"],
      "@nova/game-engine": ["../../packages/game-engine/src/index.ts"],
      "@nova/logger": ["../../packages/logger/src/index.ts"],
      "@nova/auth": ["../../packages/auth/src/index.ts"],
      "@nova/wallet": ["../../packages/wallet/src/index.ts"],
      "@nova/validation": ["../../packages/validation/src/index.ts"],
      "@nova/i18n": ["../../packages/i18n/src/index.ts"],
      "@nova/game-coin-flip": ["../../games/coin-flip/src/index.ts"],
      "@nova/game-dice": ["../../games/dice/src/index.ts"],
      "@nova/game-crash": ["../../games/crash/src/index.ts"],
      "@nova/game-roulette": ["../../games/roulette/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
