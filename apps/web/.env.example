# ==============================================================================
# NOVA Gaming Platform - Player Web Application (.env.example)
# ==============================================================================
# Build-time environment variables injected into the Vite frontend build.

# Public API REST endpoint URL (e.g. https://novagame.et/api/v1 or http://localhost:5000/api/v1)
VITE_API_URL=https://novagame.et/api/v1

# Public WebSocket / Socket.IO server URL (e.g. https://novagame.et or http://localhost:5000)
VITE_SOCKET_URL=https://novagame.et

