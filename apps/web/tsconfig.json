{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@nova/types": ["../../packages/types"],
      "@nova/ui": ["../../packages/ui"],
      "@nova/i18n": ["../../packages/i18n"],
      "@nova/auth": ["../../packages/auth"],
      "@nova/wallet": ["../../packages/wallet"],
      "@nova/fairness": ["../../packages/fairness"],
      "@nova/game-engine": ["../../packages/game-engine"],
      "@nova/game-coin-flip": ["../../games/coin-flip"],
      "@nova/game-dice": ["../../games/dice"],
      "@nova/game-crash": ["../../games/crash"],
      "@nova/game-roulette": ["../../games/roulette"],
      "@nova/game-mines": ["../../games/mines"],
      "@nova/game-bingo": ["../../games/bingo"],
      "@nova/game-limbo": ["../../games/limbo"],
      "@nova/game-plinko": ["../../games/plinko"],
      "@nova/game-hilo": ["../../games/hilo"],
      "@nova/game-dama": ["../../games/dama"],
      "@nova/game-letti": ["../../games/letti"]
    }
  },
  "include": ["src/**/*"]
}
